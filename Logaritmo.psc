Algoritmo Logaritmos
	Definir a Como Real
	Imprimir "Ingrese un numero:"
	Leer a 
	seno =  SEN (a)
	coseno = COS(a)
	tangente = TAN (a)
	raizc = rc(a)
	lna = LN (a)
	loga = (LN (a)) / (LN (10))
	Imprimir "Del numero" , a
	Imprimir "Su seno es:" , seno
	Imprimir "Su coseno es:", coseno
	Imprimir "Su tangente es:",tangente
	Imprimir "Su raiz es :" , raizc
	Imprimir "Su Logaritmo natural es : ", lna
	Imprimir "Su logaritmo en base 10 es:" , loga


FinAlgoritmo
