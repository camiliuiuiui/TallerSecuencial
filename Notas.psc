Algoritmo Nota
	Definir nota1,nota2,nota3,nota4 Como Real
	Imprimir "Escriba su primera nota:"
	Leer nota1
	Imprimir "Escriba su segunda nota:"
	Leer nota2
	Imprimir "Escriba su tercera nota:"
	Leer nota3
	Imprimir "Escriba su cuarta nota:"
	Leer nota4
	promedio = (nota1+nota2+nota3+nota4)/4
Imprimir "Su promedio es:", promedio 
FinAlgoritmo
