Algoritmo DosPalabras
	Definir palabra1, palabra2, palabra3 Como Caracter
	Imprimir "Ingrese la primer palabra: "
	Leer palabra1
	Imprimir "Ingrese la segunda palabra: "
	Leer palabra2
	palabra3 = palabra1
	palabra1 = palabra2
	palabra2 = palabra3
	Imprimir "El contenido de la Palabra 1 es: ", palabra1
	Imprimir "El contenido de la Palabra 2 es: ", palabra2
FinAlgoritmo
