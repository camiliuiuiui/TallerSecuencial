Algoritmo numerosMayores
	Definir a,b Como Real
	Imprimir "	Ingrese un numero"
	Leer a
	Imprimir "	Ingrese segundo numero"
	Leer b
	Si a==b Entonces
		Imprimir "Son iguales"
	SiNo 
		Si a>b  Entonces
			Imprimir "El primer numero es mayor"
		Sino 
			Imprimir "El segundo numero es mayor"
		FinSi
	FinSi
FinAlgoritmo
