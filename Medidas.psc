Algoritmo Medidas
	Definir cm, yardas, metros, pies, pulgadas Como Real
	Imprimir "Ingrese los centimetros: "
	Leer cm
	metros = cm / 100
	yardas = cm / 91.44
	pies = cm / 30.48
	pulgadas = cm / 2.54
	Imprimir "En metros es: ", metros
	Imprimir "En yardas es: ", yardas
	Imprimir "En pies es: ", pies
	Imprimir "En pulgadas es: ", pulgadas
FinAlgoritmo
