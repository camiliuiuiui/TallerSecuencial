Algoritmo Rectangulo
	Definir base, altura Como Real
	Imprimir "Escriba la base del rectangulo"
	Leer base
	Imprimir "Escriba la altura del rectangulo"
	Leer altura 
	perimetro = (2*base)+ (2*altura)
	area = base*altura
	Imprimir "El area del rectangulo es:", area
	Imprimir "El perimetro del rectangulo es:", perimetro
FinAlgoritmo
