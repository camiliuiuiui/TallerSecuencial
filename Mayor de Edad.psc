Algoritmo mayorEdad
	Definir edad Como Real
	Definir nombre Como Cadena
	Imprimir "	Cual es su nombre?"
	Leer nombre
	Imprimir "	Cual es su edad?"
	Leer edad
	Si edad >=18 Entonces
		Imprimir nombre," ","usted es mayor de edad"
	SiNo
		Imprimir nombre," ", "usted es menor de edad"
	FinSi
FinAlgoritmo
